# HireNex v6.0 — copy this file to .env and add your own API keys.
# Keep .env private. Never commit it to GitHub.
GEMINI_API_KEY=
GROQ_API_KEY=

# Resume extraction: Gemini first, Groq fallback.
# Retrieval query/answer: Groq first, Gemini fallback.
PARSER_PROVIDER=gemini
RETRIEVAL_PROVIDER=groq

# Current stable model IDs. Change these only to models enabled for your API account.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

GROQ_PARSER_MODEL=openai/gpt-oss-120b
GROQ_QUERY_MODEL=openai/gpt-oss-120b
GROQ_ANSWER_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Reliability-first pacing and retries. Increase intervals if your API plan has tighter limits.
GEMINI_MIN_INTERVAL_SECONDS=1.0
GROQ_MIN_INTERVAL_SECONDS=1.0
LLM_MAX_RETRIES=5
LLM_MAX_WAIT_SECONDS=300

# Comma-separated frontend origins for production deployment (leave blank locally).
# CORS_ORIGINS=https://your-frontend.vercel.app

# Optional local embedding model (downloaded on first use).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
